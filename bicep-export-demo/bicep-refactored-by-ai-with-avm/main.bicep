// AI-generated (GitHub Copilot) refactoring of the resources deployed manually by deploy-demo-resources.ps1,
// using Azure Verified Modules (https://aka.ms/avm) from the public Bicep registry.
// Compare with ../bicep-generated-by-script/<rg>/main.bicep (raw export + decompile, generated by export-to-bicep.ps1).
//
// AVM modules ship secure-by-default settings. Where they differ from the existing resources, they are overridden
// below (marked "match existing") so that adopting the resources does not change them. Remove those overrides
// deliberately, one at a time, to harden the environment.

targetScope = 'resourceGroup'

@description('Location of all resources.')
param location string = resourceGroup().location

@description('Unique suffix used in globally unique resource names.')
@minLength(1)
@maxLength(6)
param suffix string

@description('Lowercase alphanumeric prefix used in resource names; must fit Key Vault and storage account name limits.')
@minLength(1)
@maxLength(14)
param namePrefix string

@description('Short region and instance code used in resource names.')
@minLength(1)
param regionCode string

@description('Tags applied to all resources.')
param tags object = {
  environment: 'demo'
  purpose: 'bicep-export-demo'
  managedBy: 'bicep'
}

@description('Name of an existing role assignment to adopt. Leave empty to let AVM generate a deterministic name.')
param storageRoleAssignmentName string?

@description('Name of an existing role assignment to adopt. Leave empty to let AVM generate a deterministic name.')
param keyVaultRoleAssignmentName string?

@description('Send AVM usage telemetry to Microsoft.')
param enableTelemetry bool = true

@description('SKU name for the storage account.')
param storageSkuName string

@description('Blob storage access tier.')
param storageAccessTier string

@description('SKU for the Key Vault.')
@allowed([
  'standard'
  'premium'
])
param keyVaultSku string

@description('Address prefix for the virtual network.')
param virtualNetworkAddressPrefix string

@description('Address prefix for the application subnet.')
param appSubnetAddressPrefix string

@description('Address prefix for the data subnet.')
param dataSubnetAddressPrefix string

@description('SKU name for the App Service plan.')
param appServicePlanSkuName string

@description('Instance capacity for the App Service plan.')
@minValue(1)
param appServicePlanSkuCapacity int

@description('Linux runtime stack for the web app.')
param linuxFxVersion string

// ---------- Identity ----------
module identity 'br/public:avm/res/managed-identity/user-assigned-identity:0.6.0' = {
  params: {
    name: 'id-${namePrefix}-${regionCode}'
    location: location
    tags: tags
    enableTelemetry: enableTelemetry
  }
}

// ---------- Storage ----------
module storage 'br/public:avm/res/storage/storage-account:0.33.2' = {
  params: {
    name: 'st${namePrefix}${suffix}'
    location: location
    tags: tags
    enableTelemetry: enableTelemetry
    skuName: storageSkuName // match existing (AVM default: Standard_GRS)
    kind: 'StorageV2'
    accessTier: storageAccessTier
    allowSharedKeyAccess: false
    allowBlobPublicAccess: false
    requireInfrastructureEncryption: false // match existing (AVM default: true, cannot be changed after creation)
    publicNetworkAccess: 'Disabled'
    networkAcls: {
      bypass: 'None'
      defaultAction: 'Allow' // match existing (AVM default: Deny)
    }
    blobServices: {
      deleteRetentionPolicyEnabled: false // match existing (AVM default: true, 6 days)
      containerDeleteRetentionPolicyEnabled: false // match existing (AVM default: true, 7 days)
      containers: [
        { name: 'data', publicAccess: 'None' }
      ]
    }
    roleAssignments: [
      {
        name: storageRoleAssignmentName
        roleDefinitionIdOrName: 'Storage Blob Data Reader'
        principalId: identity.outputs.principalId
        principalType: 'ServicePrincipal'
      }
    ]
  }
}

// ---------- Network ----------
module nsgApp 'br/public:avm/res/network/network-security-group:0.5.4' = {
  params: {
    name: 'nsg-${namePrefix}-app-${regionCode}'
    location: location
    tags: tags
    enableTelemetry: enableTelemetry
    securityRules: [
      {
        name: 'Allow-HTTPS-Inbound'
        properties: {
          priority: 100
          direction: 'Inbound'
          access: 'Allow'
          protocol: 'Tcp'
          sourceAddressPrefix: 'Internet'
          sourcePortRange: '*'
          destinationAddressPrefix: '*'
          destinationPortRange: '443'
        }
      }
    ]
  }
}

module vnet 'br/public:avm/res/network/virtual-network:0.10.2' = {
  params: {
    name: 'vnet-${namePrefix}-${regionCode}'
    location: location
    tags: tags
    enableTelemetry: enableTelemetry
    addressPrefixes: [virtualNetworkAddressPrefix]
    subnets: [
      {
        name: 'snet-app'
        addressPrefix: appSubnetAddressPrefix
        networkSecurityGroupResourceId: nsgApp.outputs.resourceId
        privateEndpointNetworkPolicies: 'Disabled' // match existing (AVM default: Enabled)
      }
      {
        name: 'snet-data'
        addressPrefix: dataSubnetAddressPrefix
        serviceEndpoints: ['Microsoft.Storage']
        privateEndpointNetworkPolicies: 'Disabled' // match existing (AVM default: Enabled)
      }
    ]
  }
}

// ---------- Secrets ----------
module keyVault 'br/public:avm/res/key-vault/vault:0.14.3' = {
  params: {
    name: 'kv-${namePrefix}-${suffix}'
    location: location
    tags: tags
    enableTelemetry: enableTelemetry
    sku: keyVaultSku // match existing (AVM default: premium)
    enableRbacAuthorization: true
    softDeleteRetentionInDays: 7 // match existing (AVM default: 90, cannot be changed after creation)
    enablePurgeProtection: false // match existing (AVM default: true, irreversible once enabled)
    enableVaultForDeployment: false // match existing (AVM default: true)
    enableVaultForTemplateDeployment: false // match existing (AVM default: true)
    enableVaultForDiskEncryption: false // match existing (AVM default: true)
    publicNetworkAccess: 'Disabled'
    roleAssignments: [
      {
        name: keyVaultRoleAssignmentName
        roleDefinitionIdOrName: 'Key Vault Secrets User'
        principalId: identity.outputs.principalId
        principalType: 'ServicePrincipal'
      }
    ]
  }
}

// ---------- Web app ----------
module appServicePlan 'br/public:avm/res/web/serverfarm:0.7.1' = {
  params: {
    name: 'asp-${namePrefix}-${regionCode}'
    location: location
    tags: tags
    enableTelemetry: enableTelemetry
    kind: 'linux'
    skuName: appServicePlanSkuName // match existing (AVM default: P1v3)
    skuCapacity: appServicePlanSkuCapacity // match existing (AVM default: 3)
    zoneRedundant: false
  }
}

module webApp 'br/public:avm/res/web/site:0.24.0' = {
  params: {
    name: 'app-${namePrefix}-${suffix}'
    location: location
    tags: tags
    enableTelemetry: enableTelemetry
    kind: 'app,linux'
    serverFarmResourceId: appServicePlan.outputs.resourceId
    httpsOnly: true
    clientAffinityProxyEnabled: false // match existing (AVM default: true)
    clientCertMode: 'Required' // match existing (AVM default: Optional)
    managedIdentities: {
      userAssignedResourceIds: [identity.outputs.resourceId]
    }
    siteConfig: {
      linuxFxVersion: linuxFxVersion
      alwaysOn: false // F1 does not support Always On (AVM default: true)
      minTlsVersion: '1.2'
      ftpsState: 'FtpsOnly'
    }
    configs: [
      {
        name: 'appsettings'
        properties: {
          STORAGE_ACCOUNT_NAME: storage.outputs.name
          KEY_VAULT_URI: keyVault.outputs.uri
        }
      }
    ]
  }
}

output webAppUrl string = 'https://${webApp.outputs.defaultHostname}'
